# ==============================================================================
# Videogen-Lucy Environment Configuration
# ==============================================================================

# Server
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///storage/videogen.db
# Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/videogen_db

# Provider Selection
# Options: "wan_local", "replicate", "hunyuan", "cogvideo", "simulation"
VIDEO_PROVIDER=simulation

# Options: "edge_tts", "xtts", "elevenlabs", "mock"
VOICE_PROVIDER=edge_tts

# Options: "diffusers", "replicate", "openai", "mock"
IMAGE_PROVIDER=mock

# Options: "local", "s3"
STORAGE_PROVIDER=local

# Optional Cloud API Keys (Leave blank for 100% open-source local execution)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# AWS S3 (If STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Video Generation Defaults
DEFAULT_RESOLUTION=1080p
DEFAULT_ASPECT_RATIO=16:9
DEFAULT_FPS=24
FFMPEG_PATH=ffmpeg
